<script type="text/javascript" language="javascript" src="~/Scripts/faulkner.js"></script>
<div class="page-header">
    <h3 class="top_margin display-4">Faulkner Dictionary</h3>
</div>

<select class="js-example-basic-single chp" onchange="updatePageValues()">
    <option></option>
</select>

<select class="js-example-basic-single pg">
    <option></option>
</select>

<span class="input-group-btn">
    <button class="btn btn-outline-dark" type="button" value="Submit" onclick="updatePageEntries('current')">
        <i class="fas fa-search"></i>
        Search
    </button>
</span>
<hr/>
<div style="display:none;" id="hiddenTable">
    <div style="display: flex; justify-content: center;">
        <button class="btn btn-outline-dark" type="button" value="Submit" onclick="updatePageEntries('previous')">
            <i class="fas fa-angle-double-left"></i>
            Previous Page
        </button>
        <h5 class="currentPg" style="padding: 0.5em;">Current Page: None</h5>
        <button class="btn btn-outline-dark" type="button" value="Submit" onclick="updatePageEntries('next')">
            <i class="fas fa-angle-double-right"></i>
            Next Page
        </button>
    </div>
    <div>
        <div id="loadScreen" style="display:none" class="loading">Loading&#8230;</div>
        <table class="table table-hover" margin-top: 2em;">
            <thead style="width: 100%">
                <tr>
                    <th>Hieroglyphs</th>
                    <th>Transliteration</th>
                    <th>Gardiner Signs</th>
                    <th>Translations</th>
                </tr>
            </thead>
            <tbody id="resultBody"></tbody>
        </table>
    </div>
    <div style="display: flex;justify-content: center;">
        <button class="btn btn-outline-dark" type="button" value="Submit" onclick="updatePageEntries('previous')">
            <i class="fas fa-angle-double-left"></i>
            Previous Page
        </button>
        <h6 class="currentPg" style="padding: 0.5em;">Current Page: None</h6>
        <button class="btn btn-outline-dark" type="button" value="Submit" onclick="updatePageEntries('next')">
            <i class="fas fa-angle-double-right"></i>
            Next Page
        </button>
    </div>
</div>
<p>
    @Html.ActionLink("Back to Search", "Index")
</p>
